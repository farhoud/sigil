@packages/core/src/graph.sigil from SigilGraphBuilder import { GraphConstruction }
@packages/core/src/resolver.sigil from SigilResolver import { TagResolution }
@packages/core/src/context-retrieval.sigil from SigilContextRetrieval import { provider, unknown component, selected component }
@packages/core/src/filesystem.sigil from SigilFileSystem import { host filesystem access }
@packages/core/src/model/graph.sigil from SigilGraphModel import { GraphModel }
@packages/core/src/model/resolution.sigil from SigilResolutionModel import { ResolutionModel }
@spec/language.sigil from SigilLanguage import { imported Tag }
@packages/core/src/workspace.sigil from SigilWorkspaceLoader import { RecoverableResults }

component SigilProjections {
  goal {
    Provide *small structured views* over resolved Sigil data for CLI, LSP,
    renderer,
    and agent integrations.

    Prevent hosts from reinterpreting raw declarations to obtain component, Tag,
    and *complete component views*.
  }

  logic {
    ContractProjection {
      Preserve *resolved component order*.

      Return goal and interface semantic text without adding
      *projection interpretation*.

      Preserve Tag *identifiers*, grouped lines, source ranges, and ungrouped
      interface
      lines.
    }

    TagScopeProjection {
      Return the namespace built by TagResolution without changing identity, selected
      accessibility, origin, contextual occurrences, references, or source order.
    }

    ComponentDesignProjection {
      Return every contract section and Facet of the selected component, preserving
      their roles.
    }

    AgentDependencyContext {
      Resolve each *direct dependency* from imports declared by the selected
      component source.

      Preserve *deterministic import order* and include each resolved dependency
      once.

      Project each direct dependency's Goal and Interface.

      Include the *complete owning declaration* as provider interpretation context,
      including decisions labeled as rationale; selected vocabulary remains explicit.
    }

    AgentDependentContext {
      Resolve *direct importing files* from selected-Tag provider graph edges
      targeting
      the selected component name and file.

      Preserve *deterministic ordering* by importing file path and Tag-selection edge
      identity.

      Project goal/interface contracts declared in each *importing file* only as
      contextual contracts.
    }
  }

  constraints {

    Every imported Tag keeps its *originating identity* and complete provider
      interpretation context. Every *consumer use* keeps its consumer component,
      contract role,
      Facet, exact occurrence range, and source. Provider projections exclude
      consumer-only Facets; shared spelling or imports never prove runtime calls or
      behavioral equivalence.

    ProjectionInputs {
      Projections consume ResolutionModel data from TagResolution and GraphModel data
      built by GraphConstruction.

      They perform no host filesystem access, parsing, resolution, Markdown
      rendering, or agent ranking.
    }

    RecoverableResults keeps missing Goal and Interface sections as empty
    projection collections while diagnostics remain in the *resolved workspace*.

    AgentDependencyContext {
      Agent dependency context is out-of-band inspection and does not change
      *language-level selected-name accessibility*.

      *Dependency decisions* provide rationale and do not become dependent-facing or
      transitively binding.

      Do not automatically traverse transitive dependencies; required selected-Tag
      origin context uses the *provider complete declaration*, without importing
      unselected names or consumer contributions.
    }

    AgentDependentContext {
      Dependent context is derived from *resolved graph data* without filesystem
      access, parsing, or semantic inference.

      A component declared in an importing file is contextual information and is
      not
      a proven dependent.

      Only direct importing files contribute dependent context.
    }
  }

  cases {
    ContractProjection {
      A *resolved component projects* its goal/interface contract with declaration
      path
      and source-aware Tag blocks.
    }

    TagScopeProjection {
      An imported Tag retains its *origin* and contextual importer occurrences.

      Selecting a provider excludes lines contributed only by its consumers.
    }

    ComponentDesignProjection {
      A component with all seven contracts returns its *complete declaration* and
      every
      owned Facet.

      An unknown component returns undefined.
    }

    AgentDependencyContext {
      The selected component receives the goal/interface contracts and decision
      sections of each direct dependency.

      A dependency's *decisions* remain labeled as rationale rather than part of its
      goal/interface contract.

      A *transitive dependency* contributes no decisions unless selected explicitly.
    }

    AgentDependentContext {
      Selecting a component with importing files reports each direct importing file
      once.

      Duplicate import edges do not duplicate an importing file.

      An importing file with multiple component declarations reports each declaration
      as *contextual contract information*.

      An importing file with no component declarations still reports the importing
      file and *import-edge information*.

      A component with no direct importing files reports an
      *empty dependent context*.

      Import cycles do not make the selected component its own dependent.
    }
  }

  interface {
    ContractProjection {
      componentContracts(resolvedWorkspace) returns one *ComponentContractView* per
      resolved component

      ComponentContractView exposes component name, source path, *goal lines*,
      interface lines, ungrouped interface lines, and interface Tag blocks
    }

    TagScopeProjection {
      tagNamespaceFor(resolvedWorkspace, componentName) returns that component's
      *contextual resolved Tag namespace* or undefined
    }

    ComponentDesignProjection {
      componentDesignFor(resolvedWorkspace, componentName) returns the complete
      *owning component declaration* or undefined.
    }

    AgentDependencyContext {
      agentDependencyContextFor(resolvedWorkspace, componentName) returns the
      *selected complete component*, direct provider interpretation contexts, actual
      consumer Tag uses, and related source paths, or undefined.
    }

    AgentDependentContext {
      agentDependentContextFor(resolvedWorkspace, componentName) returns direct
      *importing-file context* for the selected component, or undefined
    }
    Exposes complete declaration to direct consumers.

    Exposes direct importing files to direct consumers.

    Exposes resolved workspace to direct consumers.

  }

  decisions {
    AgentDependencyContext {
      Decision: Automatically include durable decisions from direct dependencies in
      agent context.

      Scope: Applies to *agent context projection* for direct dependencies and
      excludes
      language-level imports, transitive dependencies, and automatic transitive
      dependency traversal.

      Trade-offs: Uses *additional context* and may include irrelevant rationale in
      exchange for reducing missed architectural intent and extra discovery calls.

      Revisit when: Typical dependency decision sets become too large or evidence
      shows that automatic rationale *reduces agent accuracy*.
    }

    AgentDependentContext {
      Decision: Derive dependent context from resolved selected-Tag provider graph
      *edges* as file-level importing context.

      Scope: Applies to *optional agent context* for selected components and excludes
      resolver changes, graph generation changes, source reparsing, and inferred
      component-level dependency claims.

      Trade-offs: File-level context may include components that do not actually
      depend on the selected component, but avoids unsupported semantic inference and
      preserves deterministic structural behavior.

      Consequences: Consumers must treat declared components in *importing files* as
      contextual contracts only, not proven dependents.

      Revisit when: Sigil represents *component-level import ownership* rather than
      file-level import declarations.
    }
  }
}
